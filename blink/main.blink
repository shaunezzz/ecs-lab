option Casing = Snake
option PromiseLibrary = "ReplicatedStorage.packages.promise"

option TypesOutput = "../src/shared/types.luau"
option ServerOutput = "../src/server/blink.luau"
option ClientOutput = "../src/client/blink.luau"

type UUID = string(36)

event request_full {
    From: Client,
    Type: Reliable,
    Call: Polling,
}

event send_full {
    From: Server,
    Type: Reliable,
    Call: Polling,
    Data: (buffer, unknown)
}

event send_unreliables {
    From: Server,
    Type: Unreliable,
    Call: Polling,
    Data: (buffer, unknown)
}

event send_reliables {
    From: Server,
    Type: Reliable,
    Call: Polling,
    Data: (buffer, unknown)
}
